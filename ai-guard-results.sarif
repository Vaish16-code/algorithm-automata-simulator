{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ai-guard",
          "version": "1.3.0",
          "informationUri": "https://github.com/YashJadhav21/eslint-plugin-ai-guard",
          "rules": [
            {
              "id": "ai-guard/no-async-without-await",
              "shortDescription": {
                "text": "Async function contains no await expressions"
              },
              "fullDescription": {
                "text": "Async function contains no await expressions"
              },
              "help": {
                "text": "Remove `async` if no async operations are needed, or add an `await` expression.",
                "markdown": "**Async function contains no await expressions**\n**Fix:** Remove `async` if no async operations are needed, or add an `await` expression.\n[View rule documentation](https://github.com/YashJadhav21/eslint-plugin-ai-guard/blob/main/docs/rules/no-async-without-await.md)"
              },
              "helpUri": "https://github.com/YashJadhav21/eslint-plugin-ai-guard/blob/main/docs/rules/no-async-without-await.md",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "async",
                  "async-reliability",
                  "async-reliability"
                ],
                "confidence": "informational",
                "category": "Async Reliability",
                "problem.severity": "recommendation"
              }
            },
            {
              "id": "ai-guard/no-empty-catch",
              "shortDescription": {
                "text": "Empty catch block silently swallows errors"
              },
              "fullDescription": {
                "text": "Empty catch block silently swallows errors"
              },
              "help": {
                "text": "Add error handling in the catch block, or at minimum log the error.",
                "markdown": "**Empty catch block silently swallows errors**\n**Fix:** Add error handling in the catch block, or at minimum log the error.\n[View rule documentation](https://github.com/YashJadhav21/eslint-plugin-ai-guard/blob/main/docs/rules/no-empty-catch.md)"
              },
              "helpUri": "https://github.com/YashJadhav21/eslint-plugin-ai-guard/blob/main/docs/rules/no-empty-catch.md",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "reliability",
                  "reliability"
                ],
                "confidence": "high",
                "category": "Reliability",
                "problem.severity": "high"
              }
            },
            {
              "id": "ai-guard/no-floating-promise",
              "shortDescription": {
                "text": "Promise not awaited or error-handled — async failures will be silently swallowed"
              },
              "fullDescription": {
                "text": "Promise not awaited or error-handled — async failures will be silently swallowed"
              },
              "help": {
                "text": "Add `await` before the call, assign to a variable, or add `.catch()` to handle rejection.",
                "markdown": "**Promise not awaited or error-handled — async failures will be silently swallowed**\n**Fix:** Add `await` before the call, assign to a variable, or add `.catch()` to handle rejection.\n[View rule documentation](https://github.com/YashJadhav21/eslint-plugin-ai-guard/blob/main/docs/rules/no-floating-promise.md)"
              },
              "helpUri": "https://github.com/YashJadhav21/eslint-plugin-ai-guard/blob/main/docs/rules/no-floating-promise.md",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "async",
                  "async-reliability",
                  "async-reliability"
                ],
                "confidence": "high",
                "category": "Async Reliability",
                "problem.severity": "high"
              }
            }
          ]
        }
      },
