{
  "baseUrl": "http://localhost:3000",
  "testSettings": {
    "slowMo": 1000,
    "headless": false,
    "viewport": {
      "width": 1920,
      "height": 1080
    },
    "timeout": 10000,
    "screenshotOnError": true,
    "screenshotOnSuccess": true
  },
  "testSuites": {
    "finiteAutomata": {
      "enabled": true,
      "tests": [
        {
          "name": "DFA Basic Test",
          "url": "/auto/finite-automata/dfa",
          "difficulty": "easy"
        },
        {
          "name": "NFA Test",
          "url": "/auto/finite-automata/nfa",
          "difficulty": "medium"
        },
        {
          "name": "NFA to DFA Conversion",
          "url": "/auto/finite-automata/nfa-to-dfa",
          "difficulty": "hard"
        },
        {
          "name": "DFA Minimization",
          "url": "/auto/finite-automata/minimization",
          "difficulty": "hard"
        }
      ]
    },
    "regularExpressions": {
      "enabled": true,
      "tests": [
        {
          "name": "Basic Regex Matching",
          "url": "/auto/regular-expressions",
          "difficulty": "easy"
        }
      ]
    },
    "contextFreeGrammar": {
      "enabled": true,
      "tests": [
        {
          "name": "CFG Parser",
          "url": "/auto/context-free-grammar",
          "difficulty": "medium"
        }
      ]
    },
    "pushdownAutomata": {
      "enabled": true,
      "tests": [
        {
          "name": "PDA Simulator",
          "url": "/auto/pushdown-automata",
          "difficulty": "hard"
        }
      ]
    },
    "turingMachines": {
      "enabled": true,
      "tests": [
        {
          "name": "TM Simulator",
          "url": "/auto/turing-machines/simulator",
          "difficulty": "expert"
        }
      ]
    }
  },
  "testCases": {
    "dfa": {
      "easy": [
        {
          "name": "Accept single character",
          "states": ["q0", "q1"],
          "alphabet": ["a"],
          "transitions": [{"from": "q0", "symbol": "a", "to": "q1"}],
          "startState": "q0",
          "acceptStates": ["q1"],
          "testStrings": ["a", "aa", ""],
          "expectedResults": [true, false, false]
        }
      ],
      "medium": [
        {
          "name": "Even number of 1s",
          "states": ["q0", "q1"],
          "alphabet": ["0", "1"],
          "transitions": [
            {"from": "q0", "symbol": "0", "to": "q0"},
            {"from": "q0", "symbol": "1", "to": "q1"},
            {"from": "q1", "symbol": "0", "to": "q1"},
            {"from": "q1", "symbol": "1", "to": "q0"}
          ],
          "startState": "q0",
          "acceptStates": ["q0"],
          "testStrings": ["", "11", "101", "1", "111"],
          "expectedResults": [true, true, false, false, false]
        }
      ],
      "hard": [
        {
          "name": "Complex pattern - contains 101",
          "states": ["q0", "q1", "q2", "q3"],
          "alphabet": ["0", "1"],
          "transitions": [
            {"from": "q0", "symbol": "0", "to": "q0"},
            {"from": "q0", "symbol": "1", "to": "q1"},
            {"from": "q1", "symbol": "0", "to": "q2"},
            {"from": "q1", "symbol": "1", "to": "q1"},
            {"from": "q2", "symbol": "0", "to": "q0"},
            {"from": "q2", "symbol": "1", "to": "q3"},
            {"from": "q3", "symbol": "0", "to": "q3"},
            {"from": "q3", "symbol": "1", "to": "q3"}
          ],
          "startState": "q0",
          "acceptStates": ["q3"],
          "testStrings": ["101", "1101", "1010", "110", "1011"],
          "expectedResults": [true, true, false, false, true]
        }
      ]
    },
    "regex": {
      "easy": [
        {
          "name": "Simple literal",
          "regex": "abc",
          "testStrings": ["abc", "ab", "abcd", "xyz"],
          "expectedResults": [true, false, false, false]
        }
      ],
      "medium": [
        {
          "name": "Kleene star",
          "regex": "ab*c",
          "testStrings": ["ac", "abc", "abbc", "abbbc", "ab"],
          "expectedResults": [true, true, true, true, false]
        }
      ],
      "hard": [
        {
          "name": "Complex union with grouping",
          "regex": "(a|b)*abb",
          "testStrings": ["abb", "aabb", "babb", "ababb", "ab"],
          "expectedResults": [true, true, true, true, false]
        }
      ]
    },
    "cfg": {
      "easy": [
        {
          "name": "Simple CFG",
          "productions": ["S -> a", "S -> b"],
          "testStrings": ["a", "b", "ab", ""],
          "expectedResults": [true, true, false, false]
        }
      ],
      "medium": [
        {
          "name": "Balanced parentheses",
          "productions": ["S -> (S)", "S -> SS", "S -> ε"],
          "testStrings": ["()", "(())", "((()))", "(()", ")))"],
          "expectedResults": [true, true, true, false, false]
        }
      ],
      "hard": [
        {
          "name": "a^n b^n",
          "productions": ["S -> aSb", "S -> ε"],
          "testStrings": ["ab", "aabb", "aaabbb", "a", "aab"],
          "expectedResults": [true, true, true, false, false]
        }
      ]
    }
  },
  "studentBehavior": {
    "thinkingTime": {
      "min": 2000,
      "max": 5000
    },
    "typingSpeed": {
      "min": 50,
      "max": 200
    },
    "errorProbability": 0.1,
    "retryAttempts": 3,
    "explorationTime": 3000
  },
  "reporting": {
    "generateScreenshots": true,
    "generateVideo": false,
    "detailedLogs": true,
    "includePerformanceMetrics": true,
    "emailReport": false
  }
}
